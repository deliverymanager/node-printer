{
  "name": "printer",
  "description": "Node.js printer bindings",
  "version": "0.4.1",
  "homepage": "http://github.com/tojocky/node-printer",
  "author": {
    "name": "Ion Lupascu",
    "url": "http://program-support.co.uk/",
    "email": "ionlupascu@gmail.com"
  },
  "contributors": [
    "Name Lastname <email@server.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deliverymanager/node-printer.git"
  },
  "devDependencies": {
    "grunt": "1.6.1",
    "grunt-contrib-copy": "1.0.0",
    "grunt-contrib-jshint": "3.2.0",
    "nodeunit": "0.11.3"
  },
  "engines": {
    "node": ">= 0.8.0"
  },
  "scripts": {
    "manually_build_node16": "echo 'open powershell in admin mode and press nvm use 16.15.1 && npm rebuild -g'",
    "update_modules": "ncu -u && npm i --legacy-peer-deps",
    "preinstall": "node-gyp configure",
    "install": "node-gyp build",
    "build-node-lts": "node-gyp configure build",
    "npg": "node-gyp build",
    "npg-clean": "node-pre-gyp clean",
    "npg-build": "node-pre-gyp build",
    "release:build": "node scripts/release-launcher.js build",
    "release:setup": "node scripts/release-launcher.js setup",
    "release:verify": "node scripts/release-launcher.js verify",
    "test": "node scripts/test-release-provenance.js",
    "test:legacy": "nodeunit test"
  },
  "binary": {
    "module_name": "node_printer",
    "module_path": "./lib/",
    "host": "https://github.com/tojocky/node-printer/releases/download/",
    "remote_path": "{version}"
  },
  "licenses": [
    {
      "type": "BSD"
    }
  ],
  "main": "./lib/printer",
  "dependencies": {
    "nan": "2.24.0",
    "node-gyp": "9.4.1",
    "node-pre-gyp": "0.14.0",
    "tar": "6.2.1"
  }
}
